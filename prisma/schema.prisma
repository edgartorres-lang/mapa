// Schema do Mapa da Proteção.
// Vocabulário e distinções seguem ESPECIFICACAO.md / README.md do handoff de design
// (design_handoff_mapa_protecao/). Não renomeie os termos do glossário (estudo, mapa,
// capital a proteger, etc.) — foram definidos com o cliente para evitar ambiguidade.
//
// Regra central: Estudo guarda só entrada crua (`dados`) — nada derivado é persistido
// enquanto está aberto. Mapa guarda o snapshot congelado de tudo que foi calculado, mais os
// fatores usados na geração. Ver src/lib/calc.ts para o motor de cálculo.
//
// Convenção de nomes: campos em camelCase (padrão TypeScript/Prisma Client) — cada um mapeado
// pra uma coluna snake_case no Postgres via @map, pra bater com os nomes de tabela (@@map) e
// não deixar coluna tipo "capitalAProteger" exigindo aspas em toda consulta SQL direta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Corretor — corretor_id vive em cliente, estudo e mapa desde o dia 1 (decisão do cliente,
// mesmo com um corretor só na V1), para abrir a ferramenta a outros corretores sem migração.
// ---------------------------------------------------------------------------
model Corretor {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")

  // Campos de "Acesso e Identidade" — aparecem nos documentos gerados (Acesso e Identidade.dc.html)
  // e na aba "Perfil e marca" de Ajustes (adicionada a pedido do Edgar, 2026-09-03 — não estava
  // nas 6 etapas originais). `endereco` não existia no protótipo; adicionado porque o Edgar pediu
  // um lugar pra nome/endereço/telefone junto da marca.
  cargo         String? // ex.: "Consultor de proteção familiar"
  corretora     String? // nome fantasia
  susep         String?
  whatsapp      String?
  emailContato  String? @map("email_contato")
  endereco      String? // endereço do escritório, rodapé dos documentos
  razaoSocial   String? @map("razao_social") // razão social + CNPJ, rodapé dos documentos
  // `fotoUrl`/`logoClaroUrl`/`logoEscuroUrl` guardam um data URL (base64), não um link pra
  // arquivo — mais simples que montar upload pra disco/S3 pra um único corretor, e portável
  // entre SQLite (dev) e Postgres (prod) sem infra nova. Se o app abrir pra vários corretores um
  // dia, ou as imagens ficarem grandes demais pra caber num TEXT do jeito confortável, vale
  // trocar por armazenamento de arquivo de verdade — não antes disso. Ver
  // src/app/painel/ajustes/actions.ts, salvarPerfilCorretor.
  fotoUrl       String? @map("foto_url") // avatar do corretor — apresentação e e-mail
  logoClaroUrl  String? @map("logo_claro_url") // logo pra fundo escuro (marinho): capa da apresentação, e-mail, captação, barra lateral
  logoEscuroUrl String? @map("logo_escuro_url") // logo pra fundo claro (branco): proposta A4
  corDestaque   String  @default("#39CC00") @map("cor_destaque")

  // Integrações (n8n). Seis endereços de webhook (a "canalização", sempre ativa); só quatro têm
  // toggle na tela de Integrações — lead e esquecer disparam sozinhos quando o evento acontece,
  // sem chave de ligar/desligar (Acesso e Identidade.dc.html, tela 6, atualizado 2026-09-01).
  webhookLead             String? @map("webhook_lead")
  webhookAgendar          String? @map("webhook_agendar")
  webhookNotificar        String? @map("webhook_notificar")
  webhookEnviarMapa       String? @map("webhook_enviar_mapa")
  webhookGerarTexto       String? @map("webhook_gerar_texto")
  webhookEsquecer         String? @map("webhook_esquecer")
  integracaoAgendaAtiva   Boolean @default(false) @map("integracao_agenda_ativa")
  integracaoWhatsappAtiva Boolean @default(false) @map("integracao_whatsapp_ativa")
  integracaoEmailAtiva    Boolean @default(false) @map("integracao_email_ativa")
  integracaoIaAtiva       Boolean @default(false) @map("integracao_ia_ativa")

  // Preferências de agendamento — Ajustes → Horários sugeridos (Etapa 6). `pulaFimDeSemana` e
  // `ofereceCampoAberto` mudam comportamento de verdade (ver src/lib/horarios-sugeridos.ts e
  // FormularioLead.tsx). `aceitaHorarioOcupado` é só documentação por enquanto — o app nunca
  // consultou a agenda antes de oferecer um horário (não existe checagem de conflito, com ou sem
  // esta chave); fica gravado para quando existir integração real com o Google Agenda via n8n.
  // Ver AGENTS.md, "Ajustes (Etapa 6)".
  ofereceCampoAberto   Boolean @default(true) @map("oferece_campo_aberto")
  aceitaHorarioOcupado Boolean @default(true) @map("aceita_horario_ocupado")
  pulaFimDeSemana      Boolean @default(false) @map("pula_fim_de_semana")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  clientes          Cliente[]
  fatoresCalculo    FatoresCalculo?
  horariosSugeridos HorarioSugerido[]
  campanhas         Campanha[]
  exclusoesLgpd     ExclusaoLgpd[]

  @@map("corretores")
}

// Fatores editáveis em Ajustes → Fatores de cálculo. Um-para-um com o corretor; ao salvar,
// estudos em aberto recalculam com os novos fatores — mapas gerados nunca mudam (o snapshot
// deles já guarda os fatores que usou, em Mapa.fatoresUsados).
model FatoresCalculo {
  id         String   @id @default(cuid())
  corretorId String   @unique @map("corretor_id")
  corretor   Corretor @relation(fields: [corretorId], references: [id], onDelete: Cascade)

  pctCustoTransmissao   Float @default(15) @map("pct_custo_transmissao") // vitalícia
  mesesVitalicia        Int   @default(12) @map("meses_vitalicia")
  prazoManutencaoAnos   Int   @default(5) @map("prazo_manutencao_anos") // temporária
  tetoMultiplicador     Float @default(8) @map("teto_multiplicador")
  prazoPensaoAnosPadrao Int   @default(15) @map("prazo_pensao_anos_padrao") // educação
  idadeIndependencia    Int   @default(25) @map("idade_independencia")
  fatorClt              Float @default(1) @map("fator_clt") // fatores por vínculo — CLT e
  fatorServidor         Float @default(1) @map("fator_servidor") // servidor ficam travados em
  fatorPensaoServidor   Float @default(0.6) @map("fator_pensao_servidor") // 1,00 na UI, mas
  fatorAutonomo         Float @default(1.25) @map("fator_autonomo") // o campo existe
  anosInvalidez         Int   @default(5) @map("anos_invalidez") // invalidez e complementares
  pctInvalidezDoenca    Float @default(50) @map("pct_invalidez_doenca")
  pctRendaInvalidez     Float @default(50) @map("pct_renda_invalidez")
  pctDit                Float @default(70) @map("pct_dit")
  fatorDoencasGraves    Float @default(1.5) @map("fator_doencas_graves")
  diasRetencao          Int   @default(120) @map("dias_retencao") // fila de limpeza dos 120 dias

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("fatores_calculo")
}

// `EstagioFunil` e `LgpdStatus` eram `enum` — trocados por `String` pra o schema rodar em SQLite
// (dev) e Postgres (prod) sem duas versões de arquivo. Valores fechados e o tipo TS ficam em
// src/lib/enums.ts (ESTAGIOS_FUNIL, LGPD_STATUS) — valide contra eles na camada de aplicação,
// o banco não impõe mais isso sozinho. Ver AGENTS.md.

// Cliente sem `estagioFunil` (null) = "fora do funil": contato cadastrado sem nenhum estudo.
// Isso acontece quando o único mapa/estudo dele é excluído (ciclo dos 120 dias ou manual).
model Cliente {
  id         String   @id @default(cuid())
  corretorId String   @map("corretor_id")
  corretor   Corretor @relation(fields: [corretorId], references: [id], onDelete: Cascade)

  nome               String
  // true depois que o corretor corrige o nome pela página do cliente — a partir daí, um reenvio
  // do link de captação (lead repetido, mesmo telefone/e-mail) nunca mais sobrescreve o nome. Ver
  // AGENTS.md, "Captação pública", e editarNomeCliente em src/app/painel/clientes/[id]/actions.ts.
  nomeEditadoManualmente Boolean @default(false) @map("nome_editado_manualmente")
  telefone           String?
  email              String?
  // Sem @db.Date (atributo específico do Postgres, inválido no SQLite) — só data, sem hora,
  // é uma regra da camada de aplicação, não do banco.
  nascimento         DateTime?
  sexo               String? // "F" | "M" — só para a flexão dos textos, não entra no cálculo
  estadoCivil        String?   @map("estado_civil")
  profissao          String?
  idadeAposentadoria Int?      @map("idade_aposentadoria")

  origem      String? // "Link · campanha família" | "Indicação · Marina" | "Contato direto" etc.
  utmCampanha String? @map("utm_campanha")

  // "lead" | "estudo" | "apresentado" | "cotando" | "fechado" | "perdido" | null (fora do funil)
  // — ver ESTAGIOS_FUNIL em src/lib/enums.ts.
  estagioFunil        String?   @map("estagio_funil")
  estagioAtualizadoEm DateTime? @map("estagio_atualizado_em")

  // "aceito" | "verbal" | "pendente" — ver LGPD_STATUS em src/lib/enums.ts.
  lgpdStatus   String  @default("pendente") @map("lgpd_status")
  lgpdOrigem   String? @map("lgpd_origem") // onde o consentimento foi coletado (link, verbal, etc.)
  lgpdAceitoEm DateTime?  @map("lgpd_aceito_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  estudos      Estudo[]
  eventos      EventoHistorico[]
  notas        NotaCrm[]
  agendamentos Agendamento[]

  @@index([corretorId])
  @@index([corretorId, estagioFunil])
  @@map("clientes")
}

// Estudo: em aberto, aceita alteração, recalcula com os fatores atuais. `dados` é a única
// fonte de verdade das respostas — nada derivado (vitalícia, temporária, etc.) é persistido
// aqui; o motor de cálculo (src/lib/calc.ts) recalcula a cada leitura enquanto status=aberto.
model Estudo {
  id         String   @id @default(cuid())
  clienteId  String   @map("cliente_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  corretorId String   @map("corretor_id") // denormalizado de propósito — corretor_id em toda tabela de domínio

  // "aberto" | "gerado" — ver STATUS_ESTUDO em src/lib/enums.ts.
  status String @default("aberto")

  duplicadoDeEstudoId String?  @map("duplicado_de_estudo_id")
  duplicadoDe         Estudo?  @relation("Duplicacao", fields: [duplicadoDeEstudoId], references: [id])
  duplicados          Estudo[] @relation("Duplicacao")

  // Formato do EstudoDados em src/lib/calc.ts: perfil, vínculos, cônjuge, terceiros,
  // dependentes, educação (fases + extras), prazos, teto, objetivos, bens, reservas,
  // contato, consentimento LGPD.
  dados Json

  // Regeneráveis à vontade enquanto o estudo está aberto (decisão 7). Travam junto com o
  // Mapa quando gerado — ver Mapa.resumoParaVoce / Mapa.analiseInterna.
  resumoParaVoce String? @map("resumo_para_voce")
  analiseInterna String? @map("analise_interna")

  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  geradoEm     DateTime? @map("gerado_em")

  mapa Mapa?

  @@index([clienteId])
  @@index([corretorId])
  @@map("estudos")
}

// Mapa da Proteção: o estudo gerado. Travado — snapshot congelado de todos os derivados do
// calc() + os fatores usados na geração + data/hora. Nunca é editado depois de criado; a
// única correção é duplicar o estudo que o gerou (ver Estudo.duplicadoDeEstudoId) e gerar um
// novo Mapa. Não existe (e não deve existir) nenhuma rota/UI de update aqui.
model Mapa {
  id         String @id @default(cuid())
  estudoId   String @unique @map("estudo_id")
  estudo     Estudo @relation(fields: [estudoId], references: [id], onDelete: Cascade)
  clienteId  String @map("cliente_id") // denormalizado — evita join pra listar mapas de um cliente
  corretorId String @map("corretor_id") // denormalizado

  numeroVersao Int @map("numero_versao") // 1, 2, 3... por cliente

  // Números principais (glossário) — também replicados dentro de `derivados`, mas ficam como
  // colunas próprias por serem usados em listagens/filtros (funil, dashboard, comparar mapas).
  capitalAProteger      Float @map("capital_a_proteger")
  vitalicia             Float
  temporaria            Float
  custoEducacionalTotal Float @map("custo_educacional_total")
  pensaoMensal          Float @map("pensao_mensal")

  // Resto do retorno de calc() (CalcResultado completo), para a tela de Memória de Cálculo.
  derivados Json

  // Fatores em vigor no momento da geração (snapshot de FatoresCalculo) — nunca mudam depois,
  // mesmo que o corretor edite os fatores em Ajustes.
  fatoresUsados Json @map("fatores_usados")

  resumoParaVoce String? @map("resumo_para_voce") // trava com o snapshot; só entra na proposta
  analiseInterna String? @map("analise_interna") // NUNCA sai da tela do corretor — nunca em PDF/e-mail, em nenhuma rota

  geradoEm DateTime @default(now()) @map("gerado_em")

  @@index([clienteId])
  @@index([corretorId])
  @@map("mapas")
}

// Linha do tempo do cliente (tela "Resumo" da página do cliente). "Movimento no CRM" para
// zerar a fila dos 120 dias = qualquer linha nova aqui (decisão 4). Abrir a página não conta
// — não gera evento_historico.
model EventoHistorico {
  id         String  @id @default(cuid())
  clienteId  String  @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  corretorId String  @map("corretor_id")

  tipo  String // "sistema" | "manual"
  texto String

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([clienteId])
  @@map("eventos_historico")
}

// Anotações de venda — nunca entram em PDF nem e-mail (aba "Anotações" da página do cliente).
model NotaCrm {
  id         String  @id @default(cuid())
  clienteId  String  @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  corretorId String  @map("corretor_id")

  texto String

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([clienteId])
  @@map("notas_crm")
}

// Campanhas do link de captação (UTM), gerenciadas pelo corretor.
model Campanha {
  id          String   @id @default(cuid())
  corretorId  String   @map("corretor_id")
  corretor    Corretor @relation(fields: [corretorId], references: [id], onDelete: Cascade)
  nome        String
  utmCampanha String   @map("utm_campanha")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@unique([corretorId, utmCampanha])
  @@map("campanhas")
}

// Reunião marcada pelo lead (ou proposta no campo aberto). O evento no Google Agenda leva só
// nome e contato — nenhum valor do estudo (decisão de arquitetura, README "Agendamento").
model Agendamento {
  id        String  @id @default(cuid())
  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Um horário sugerido (horario1/2/3) sempre tem dataHora. O campo aberto às vezes só tem texto
  // livre ("terça de manhã") sem data estruturada — por isso dataHora é opcional e textoLivre
  // existe. Nunca os dois vazios ao mesmo tempo.
  dataHora  DateTime? @map("data_hora")
  textoLivre String?  @map("texto_livre")
  origem    String // "horario1" | "horario2" | "horario3" | "campo_aberto"

  googleEventId String? @map("google_event_id")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([clienteId])
  @@map("agendamentos")
}

// As três opções de horário oferecidas no formulário do lead (Ajustes → Horários sugeridos).
// `Captação e Agendamento.dc.html` é a fonte da verdade da regra (decisão 5): tarde de amanhã,
// manhã de depois de amanhã, tarde de depois de amanhã.
model HorarioSugerido {
  id          String   @id @default(cuid())
  corretorId  String   @map("corretor_id")
  corretor    Corretor @relation(fields: [corretorId], references: [id], onDelete: Cascade)
  ordem       Int // 1, 2, 3
  diaRelativo String   @map("dia_relativo") // "amanha" | "depois_de_amanha" | "em_tres_dias"
  hora        String // "15:00"
  duracaoMin  Int      @default(60) @map("duracao_min")

  @@unique([corretorId, ordem])
  @@map("horarios_sugeridos")
}

// Tudo que sobra depois de um pedido de exclusão LGPD (decisão 6): a linha do Cliente é
// apagada de verdade (hard delete), e fica só isto — sem nome, telefone ou e-mail.
model ExclusaoLgpd {
  id         String   @id @default(cuid())
  corretorId String   @map("corretor_id")
  corretor   Corretor @relation(fields: [corretorId], references: [id], onDelete: Cascade)
  canal      String // "whatsapp" | "email" | "verbal"
  dataPedido DateTime @default(now()) @map("data_pedido")

  @@map("exclusoes_lgpd")
}
