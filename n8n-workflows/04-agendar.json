      "id": "d4d4d4d4-0005-4000-8000-000000000005",
      "name": "Responder sem evento (sugestão livre)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $('Webhook').item.json.body.emailAtivo && $('Webhook').item.json.body.email ? 'sim' : '' }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4d4d4d4-0006-4000-8000-000000000006",
      "name": "Tem e-mail pra confirmar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Roda só quando já existe data/hora resolvida e o cliente tem e-mail (ver node \"Tem e-mail pra\n// confirmar?\"). Referencia o Webhook original (`$('Webhook')`) porque o node anterior (\"Criar\n// evento\") substitui `$json` pela resposta da API do Google, que não tem mais os campos que\n// vieram do app.\nconst body = $('Webhook').item.json.body;\nconst dataObj = new Date(body.data);\nconst dataFmt = dataObj.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'America/Belem' });\nconst horaFmt = body.hora || dataObj.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Belem' });\nconst corretorNome = body.corretorNome || 'seu corretor';\n\nconst texto = [\n  `Olá, ${body.nome}!`,\n  '',\n  `Seu horário está confirmado: ${dataFmt}, às ${horaFmt}.`,\n  '',\n  `Vai ser com ${corretorNome}. Qualquer imprevisto, é só responder este e-mail.`,\n  '',\n  'Até lá!',\n].join('\\n');\n\nreturn [{ json: { destinatario: body.email, assunto: 'Seu horário está confirmado', corpoTexto: texto } }];"
      },
      "id": "d4d4d4d4-0007-4000-8000-000000000007",
      "name": "Montar texto de confirmação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.destinatario }}",
        "subject": "={{ $json.assunto }}",
        "emailType": "text",
        "message": "={{ $json.corpoTexto }}",
        "options": {}
      },
      "id": "d4d4d4d4-0008-4000-8000-000000000008",
      "name": "Enviar confirmação (Gmail)",
      "type": "n8n-nodes-base.gmail",
