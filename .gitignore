# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca comitar segredo de verdade (senha de banco, chave da Evolution, chave da IA)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credenciais e chaves, de qualquer origem — nada disto entra no repositório, nem privado
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secrets*
service-account*.json
*.env.local

# banco SQLite de desenvolvimento local (dado fictício de teste, não é o banco de produção) e o
# schema derivado gerado por prisma.config.ts — nunca editado à mão, recriado a cada comando
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal
prisma/schema.generated.prisma

